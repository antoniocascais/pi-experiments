{
  "providers": {
    "llmbase": {
      "baseUrl": "https://api.llmbase.ai/v1",
      "api": "openai-completions",
      "apiKey": "$LLMBASE_API_KEY",
      "compat": {
        "supportsDeveloperRole": false,
        "supportsReasoningEffort": true
      },
      "models": [
        {
          "id": "minimax/minimax-m3",
