          "contextWindow": 1048576,
          "maxTokens": 64000,
          "thinkingLevelMap": {
            "minimal": null,
            "low": "low",
            "medium": "medium",
            "high": "high",
            "xhigh": "high"
          }
        },
        {
          "id": "z-ai/glm-5.2",
          "reasoning": true,
          "thinkingLevelMap": {
            "minimal": null,
            "low": "low",
            "medium": "medium",
            "high": "high",
            "xhigh": "max"
          }
        }
      ]
    }
  }
}
