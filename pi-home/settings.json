{
  "packages": ["npm:@melihmucuk/pi-crew@1.0.34"],

  "defaultProjectTrust": "never",
  "enableInstallTelemetry": false,
  "enableAnalytics": false,

  "theme": "dark",
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 20000
  },
  "retry": {
    "enabled": true,
    "maxRetries": 3,
    "baseDelayMs": 2000,
    "provider": {
      "maxRetries": 0
    }
  }
}
