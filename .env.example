# Copy to .env and chmod 600. Passed to the container with --env-file.
# Never put a GitHub token here: use GH_TOKEN_CMD with `make pi-gh` / `sh-gh` / `clone`.

# Required: provider + model from pi-home/models.json.
PI_PROVIDER=
PI_MODEL=
# Optional: thinking level (off | minimal | low | medium | high | xhigh | max). No quotes.
# The solo agent / crew principal (and pi-crew's bundled agents).
PI_THINKING=
# Crew only, per agent; empty keeps the default from pi-home/agents/<agent>.md:
# implementer medium, everything else high.
PI_THINKING_IMPLEMENTER=
PI_THINKING_REVIEWER=
PI_THINKING_ADVERSARIAL_REVIEWER=
PI_THINKING_DEVSEC_REVIEWER=
PI_THINKING_RESEARCHER=
# solo (default) or crew.
PI_MODE=solo

# Key for the provider you selected; the other may stay empty.
LLMBASE_API_KEY=
CORTECS_API_KEY=
